{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
      "paths": {
      "#/*": ["./*"],
      "@/*": ["./src/*"]
    },
    "jsxImportSource": "hono/jsx",
    "rootDir": "./",
    "outDir": "../dist"
  },
  "exclude": ["node_modules"]
}
